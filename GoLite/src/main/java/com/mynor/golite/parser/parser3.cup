package com.mynor.golite.parser;

import java_cup.runtime.*;
import java.util.ArrayList;
import java.util.List;

import com.mynor.golite.ast.*;

parser code {:
    private final List<String[]> erroresSintacticos = new ArrayList<>();
    public Symbol ultimoError = null;

    public List<String[]> getErroresSintacticos() {
        return erroresSintacticos;
    }
    private int linea(Symbol s) {
        return s == null ? -1 : s.left + 1;
    }
    private int columna(Symbol s) {
        return s == null ? -1 : s.right + 1;
    }
    private String ubicacion(Symbol s) {
        if (s == null) return "fin de entrada";
        return "línea " + linea(s) + ", columna " + columna(s);
    }
    
    private String lexema(Symbol s) {
        if (s == null) return "desconocido";

        if (s.value != null) {
            return s.value.toString();
        }

        return Terminal.terminalNames[s.sym];
    }

    @Override
    public void report_error(String message, Object info) {
        if (info instanceof Symbol s) {
            ultimoError = s;
            erroresSintacticos.add(new String[]{message, String.valueOf(linea(s)), String.valueOf(columna(s))});
        } else if (ultimoError != null) {
            erroresSintacticos.add(new String[]{message, String.valueOf(linea(ultimoError)), String.valueOf(columna(ultimoError))});
        } else {
            erroresSintacticos.add(new String[]{message, "-1", "-1"});
        }
    }

    @Override
    public void syntax_error(Symbol cur_token) {
        System.out.println(
                "sym=" + cur_token.sym +
                ", value=" + cur_token.value
            );
        ultimoError = cur_token;
        String msg = cur_token != null
            ? "Token inesperado cerca de '" + lexema(cur_token) + "' en " + ubicacion(cur_token)
            : "Error sintáctico: fin de entrada inesperado";
        erroresSintacticos.add(new String[]{
            msg,
            String.valueOf(linea(cur_token)),
            String.valueOf(columna(cur_token))
        });
    }

    @Override
    public void unrecovered_syntax_error(Symbol cur_token) throws Exception {
        throw new Exception(
            "Error sintáctico irrecuperable en " +
            (ultimoError != null ? ubicacion(ultimoError) : "posición desconocida")
        );
    }

    private NodoError mkError(String msg) {
        int l = ultimoError != null ? ultimoError.left  + 1 : -1;
        int c = ultimoError != null ? ultimoError.right + 1 : -1;
        return new NodoError(msg, l, c);
    }
:}

scan with {:
    return getScanner().next_token();
:};

terminal String    IDENTIFICADOR;
terminal Integer   ENTERO;
terminal Double    FLOTANTE;
terminal String    CADENA;
terminal Character RUNE_LIT;
terminal INT, FLOAT64, STRING, BOOL, RUNE, NIL;
terminal TRUE, FALSE;
terminal FUNC, MAIN, VAR;
terminal STRUCT;
terminal IF, ELSE;
terminal SWITCH, CASE, DEFAULT;
terminal FOR, RANGE;
terminal BREAK, CONTINUE, RETURN;
terminal APPEND, LEN;
terminal FMT, PRINTLN;
terminal SLICES, INDEX;
terminal STRINGS, JOIN;
terminal STRCONV, ATOI, PARSEFLOAT;
terminal REFLECT, TYPEOF;
terminal PLUS_ASIG, MINUS_ASIG;
terminal INCREMENTO, DECREMENTO;
terminal IGUAL, NO_IGUAL;
terminal MAYOR_IGUAL, MENOR_IGUAL;
terminal AND, OR;
terminal DECL_ASIG;
terminal ASIG;
terminal MAS, MENOS, MULT, DIV, MODULO;
terminal NOT;
terminal MAYOR, MENOR, UMENOS;
terminal DOS_PUNTOS, PUNTO, COMA, PUNTO_COMA;
terminal PAR_IZQ, PAR_DER;
terminal COR_IZQ, COR_DER;
terminal LLA_IZQ, LLA_DER;

non terminal NodoPrograma                  programa;
non terminal List<NodoDeclaracionGlobal>   lista_globales;
non terminal NodoDeclaracionGlobal         declaracion_global;
non terminal NodoTipo                      tipo;
non terminal NodoTipoSlice                 tipo_slice;
non terminal NodoDeclVar                   declaracion_variable;
non terminal NodoAsignVar                  asignacion_variable;
non terminal NodoDefStruct                 def_struct;
non terminal List<NodoAtributoStruct>      lista_atributos_struct;
non terminal NodoAtributoStruct            atributo_struct;
non terminal NodoInstanciaStruct           instancia_struct;
non terminal List<NodoCampoStruct>         lista_campos_struct;
non terminal NodoCampoStruct               campo_struct;
non terminal NodoDefFuncion                def_funcion;
non terminal List<NodoParametro>           lista_parametros;
non terminal List<NodoParametro>           lista_parametros_no_vacia;
non terminal NodoParametro                 parametro;
non terminal NodoBloque                    bloque;
non terminal List<NodoInstruccion>         instrucciones;
non terminal NodoInstruccion               instruccion;
non terminal NodoInstruccion               instruccion_terminada;
non terminal NodoIf                        sent_if;
non terminal NodoSwitch                    sent_switch;
non terminal List<NodoCaso>                lista_cases;
non terminal NodoCaso                      caso;
non terminal NodoCasoDefault               caso_default;
non terminal NodoFor                       sent_for;
non terminal NodoInstruccion               sent_for_init;
non terminal NodoInstruccion               sent_for_post;
non terminal NodoBreak                     sent_break;
non terminal NodoContinue                  sent_continue;
non terminal NodoReturn                    sent_return;
non terminal NodoExpresion                 llamada_funcion;
non terminal List<NodoExpresion>           lista_argumentos;
non terminal NodoAtoi                      expr_atoi;
non terminal NodoParsefloat                expr_parsefloat;
non terminal NodoTypeof                    expr_typeof;
non terminal NodoSlicesIndex               expr_slices_index;
non terminal NodoStringsJoin               expr_strings_join;
non terminal NodoLen                       expr_len;
non terminal NodoAppend                    expr_append;
non terminal NodoExpresion                 expresion;
non terminal NodoExpresion                 operando;
non terminal NodoLiteralSlice              literal_slice;
non terminal List<NodoLiteralSlice>        lista_filas_slice;
non terminal NodoLiteralSlice              fila_slice;
non terminal List<NodoExpresion>           lista_expresiones;

precedence left OR;
precedence left AND;
precedence left IGUAL, NO_IGUAL;
precedence left MAYOR, MENOR, MAYOR_IGUAL, MENOR_IGUAL;
precedence left MAS, MENOS;
precedence left MULT, DIV, MODULO;
precedence right NOT, UMENOS;
precedence left COR_IZQ, PAR_IZQ, LLA_IZQ, PUNTO;

start with programa;

programa ::=
      lista_globales:l
      {: RESULT = new NodoPrograma(l, lleft, lright); :}
    ;

lista_globales ::=
      lista_globales:l declaracion_global:d
      {: l.add(d); RESULT = l; :}
    | lista_globales:l PUNTO_COMA
      {: RESULT = l; :}
    | /* vacío */
      {: RESULT = new ArrayList<>(); :}
    ;

declaracion_global ::=
      def_funcion:f        {: RESULT = f; :}
    | def_struct:s         {: RESULT = s; :}
    | declaracion_variable:v {: RESULT = v; :}
    | asignacion_variable:a  {: RESULT = a; :}
    ;

declaracion_variable ::=
      VAR IDENTIFICADOR:id tipo:t ASIG expresion:e
      {: RESULT = new NodoDeclVar(id, t, null, e, idleft, idright); :}
    | VAR IDENTIFICADOR:id tipo:t
      {: RESULT = new NodoDeclVar(id, t, null, null, idleft, idright); :}
    | VAR IDENTIFICADOR:id tipo_slice:ts
      {: RESULT = new NodoDeclVar(id, null, ts, null, idleft, idright); :}
    | IDENTIFICADOR:id DECL_ASIG expresion:e
      {: RESULT = new NodoDeclVar(id, null, null, e, idleft, idright); :}
    ;

asignacion_variable ::=
      IDENTIFICADOR:id ASIG expresion:e
      {: RESULT = new NodoAsignVar(id, null, null, "=", e, idleft, idright); :}
    | IDENTIFICADOR:id PLUS_ASIG expresion:e
      {: RESULT = new NodoAsignVar(id, null, null, "+=", e, idleft, idright); :}
    | IDENTIFICADOR:id MINUS_ASIG expresion:e
      {: RESULT = new NodoAsignVar(id, null, null, "-=", e, idleft, idright); :}
    | IDENTIFICADOR:id INCREMENTO
      {: RESULT = new NodoAsignVar(id, null, null, "++", null, idleft, idright); :}
    | IDENTIFICADOR:id DECREMENTO
      {: RESULT = new NodoAsignVar(id, null, null, "--", null, idleft, idright); :}
    | IDENTIFICADOR:id COR_IZQ expresion:idx COR_DER ASIG expresion:e
      {: RESULT = new NodoAsignVar(id, idx, null, "=", e, idleft, idright); :}
    | IDENTIFICADOR:id COR_IZQ expresion:i COR_DER COR_IZQ expresion:j COR_DER ASIG expresion:e
      {: RESULT = new NodoAsignVar(id, i, j, "=", e, idleft, idright); :}
    | IDENTIFICADOR:obj PUNTO IDENTIFICADOR:campo ASIG expresion:e
      {: RESULT = new NodoAsignCampo(obj, campo, e, objleft, objright); :}
    ;

def_struct ::=
      STRUCT IDENTIFICADOR:id LLA_IZQ lista_atributos_struct:attrs LLA_DER
      {: RESULT = new NodoDefStruct(id, attrs, idleft, idright); :}
    ;

def_funcion ::=
      FUNC:f MAIN PAR_IZQ PAR_DER bloque:b
      {: RESULT = new NodoDefFuncion("main", new ArrayList<>(), null, null, true, b, fleft, fright); :}
    | FUNC:f IDENTIFICADOR:id PAR_IZQ lista_parametros:ps PAR_DER bloque:b
      {: RESULT = new NodoDefFuncion(id, ps, null, null, false, b, fleft, fright); :}
    | FUNC:f IDENTIFICADOR:id PAR_IZQ lista_parametros:ps PAR_DER tipo:t bloque:b
      {: RESULT = new NodoDefFuncion(id, ps, t, null, false, b, fleft, fright); :}
    | FUNC:f IDENTIFICADOR:id PAR_IZQ lista_parametros:ps PAR_DER tipo_slice:ts bloque:b
      {: RESULT = new NodoDefFuncion(id, ps, null, ts, false, b, fleft, fright); :}
    | FUNC:f PAR_IZQ IDENTIFICADOR:ref IDENTIFICADOR:struct PAR_DER IDENTIFICADOR:id PAR_IZQ lista_parametros:ps PAR_DER bloque:b
      {: RESULT = new NodoDefFuncionStruct(struct, ref, id, ps, null, null, b, fleft, fright); :}
    | FUNC:f PAR_IZQ IDENTIFICADOR:ref IDENTIFICADOR:struct PAR_DER IDENTIFICADOR:id PAR_IZQ lista_parametros:ps PAR_DER tipo:t bloque:b
      {: RESULT = new NodoDefFuncionStruct(struct, ref, id, ps, t, null, b, fleft, fright); :}
    | FUNC:f PAR_IZQ IDENTIFICADOR:ref IDENTIFICADOR:struct PAR_DER IDENTIFICADOR:id PAR_IZQ lista_parametros:ps PAR_DER tipo_slice:ts bloque:b
      {: RESULT = new NodoDefFuncionStruct(struct, ref, id, ps, null, ts, b, fleft, fright); :}
    ;

tipo ::=
      INT:i            {: RESULT = new NodoTipo("int",     ileft, iright); :}
    | FLOAT64:f        {: RESULT = new NodoTipo("float64", fleft, fright); :}
    | STRING:s         {: RESULT = new NodoTipo("string",  sleft, sright); :}
    | BOOL:b           {: RESULT = new NodoTipo("bool",    bleft, bright); :}
    | RUNE:r           {: RESULT = new NodoTipo("rune",    rleft, rright); :}
    | IDENTIFICADOR:id {: RESULT = new NodoTipo(id, idleft, idright); :}
    ;

tipo_slice ::=
      COR_IZQ COR_DER tipo:t
      {: RESULT = new NodoTipoSlice(t, 1, tleft, tright); :}
    | COR_IZQ COR_DER COR_IZQ COR_DER tipo:t
      {: RESULT = new NodoTipoSlice(t, 2, tleft, tright); :}
    ;

lista_atributos_struct ::=
      lista_atributos_struct:l atributo_struct:a
      {: l.add(a); RESULT = l; :}
    | atributo_struct:a
      {: List<NodoAtributoStruct> l = new ArrayList<>(); l.add(a); RESULT = l; :}
    ;

atributo_struct ::=
      tipo:t IDENTIFICADOR:id PUNTO_COMA
      {: RESULT = new NodoAtributoStruct(id, t, null, idleft, idright); :}
    | tipo_slice:ts IDENTIFICADOR:id PUNTO_COMA
      {: RESULT = new NodoAtributoStruct(id, null, ts, idleft, idright); :}
    | tipo:t IDENTIFICADOR:id
      {: RESULT = new NodoAtributoStruct(id, t, null, idleft, idright); :}
    | tipo_slice:ts IDENTIFICADOR:id
      {: RESULT = new NodoAtributoStruct(id, null, ts, idleft, idright); :}
    ;

instancia_struct ::=
      IDENTIFICADOR:id LLA_IZQ lista_campos_struct:campos LLA_DER
      {: RESULT = new NodoInstanciaStruct(id, campos, idleft, idright); :}
    | IDENTIFICADOR:id LLA_IZQ LLA_DER
      {: RESULT = new NodoInstanciaStruct(id, new ArrayList<>(), idleft, idright); :}
    ;

lista_campos_struct ::=
      lista_campos_struct:l COMA campo_struct:c
      {: l.add(c); RESULT = l; :}
    | campo_struct:c
      {: List<NodoCampoStruct> l = new ArrayList<>(); l.add(c); RESULT = l; :}
    ;

campo_struct ::=
      IDENTIFICADOR:id DOS_PUNTOS expresion:e
      {: RESULT = new NodoCampoStruct(id, e, idleft, idright); :}
    ;

lista_parametros ::=
      lista_parametros_no_vacia:l
      {: RESULT = l; :}
    | /* vacío */
      {: RESULT = new ArrayList<>(); :}
    ;

lista_parametros_no_vacia ::=
      lista_parametros_no_vacia:l COMA parametro:p
      {: l.add(p); RESULT = l; :}
    | parametro:p
      {: List<NodoParametro> l = new ArrayList<>(); l.add(p); RESULT = l; :}
    ;

parametro ::=
      IDENTIFICADOR:id tipo:t
      {: RESULT = new NodoParametro(id, t, null, idleft, idright); :}
    | IDENTIFICADOR:id tipo_slice:ts
      {: RESULT = new NodoParametro(id, null, ts, idleft, idright); :}
    ;

// Recuperacion de error en bloque

bloque ::=
      LLA_IZQ:l instrucciones:is LLA_DER
      {: RESULT = new NodoBloque(is, lleft, lright); :}
    ;

instrucciones ::=
      instrucciones:l instruccion_terminada:i
      {: l.add(i); RESULT = l; :}
    | /* vacío */
      {: RESULT = new ArrayList<>(); :}
    ;

instruccion_terminada ::=
      instruccion:i PUNTO_COMA  {: RESULT = i; :}
    | instruccion:i             {: RESULT = i; :}
    | error
      // Error en instruccion
      {:
          RESULT = mkError("Instrucción inválida");
      :}
    ;

instruccion ::=
      declaracion_variable:v  {: RESULT = v; :}
    | asignacion_variable:a   {: RESULT = a; :}
    | bloque:b                {: RESULT = b; :}
    | sent_if:s               {: RESULT = s; :}
    | sent_switch:s           {: RESULT = s; :}
    | sent_for:s              {: RESULT = s; :}
    | sent_break:s            {: RESULT = s; :}
    | sent_continue:s         {: RESULT = s; :}
    | sent_return:s           {: RESULT = s; :}
    | llamada_funcion:c       {: RESULT = c; :}
    ;


sent_if ::=
      IF:i expresion:cond bloque:b
      {: RESULT = new NodoIf(cond, b, null, null, ileft, iright); :}
    | IF:i expresion:cond bloque:b ELSE bloque:be
      {: RESULT = new NodoIf(cond, b, be, null, ileft, iright); :}
    | IF:i expresion:cond bloque:b ELSE sent_if:ei
      {: RESULT = new NodoIf(cond, b, null, ei, ileft, iright); :}
    | IF:i PAR_IZQ expresion:cond PAR_DER bloque:b
      {: RESULT = new NodoIf(cond, b, null, null, ileft, iright); :}
    | IF:i PAR_IZQ expresion:cond PAR_DER bloque:b ELSE bloque:be
      {: RESULT = new NodoIf(cond, b, be, null, ileft, iright); :}
    | IF:i PAR_IZQ expresion:cond PAR_DER bloque:b ELSE sent_if:ei
      {: RESULT = new NodoIf(cond, b, null, ei, ileft, iright); :}
    ;

sent_switch ::=
      SWITCH:s expresion:e LLA_IZQ lista_cases:cs LLA_DER
      {: RESULT = new NodoSwitch(e, cs, null, sleft, sright); :}
    | SWITCH:s expresion:e LLA_IZQ lista_cases:cs caso_default:d LLA_DER
      {: RESULT = new NodoSwitch(e, cs, d, sleft, sright); :}
    ;

lista_cases ::=
      lista_cases:l caso:c
      {: l.add(c); RESULT = l; :}
    |
      {: RESULT = new ArrayList<>(); :}
    ;

caso ::=
      CASE:c expresion:e DOS_PUNTOS instrucciones:is
      {: RESULT = new NodoCaso(e, is, cleft, cright); :}
    ;

caso_default ::=
      DEFAULT:d DOS_PUNTOS instrucciones:is
      {: RESULT = new NodoCasoDefault(is, dleft, dright); :}
    ;

sent_for ::=
      FOR:f expresion:cond bloque:b
      {: RESULT = new NodoFor(null, cond, null, null, null, b, false, fleft, fright); :}
    | FOR:f sent_for_init:init PUNTO_COMA expresion:cond PUNTO_COMA sent_for_post:post bloque:b
      {: RESULT = new NodoFor(init, cond, post, null, null, b, false, fleft, fright); :}
    | FOR:f IDENTIFICADOR:idx COMA IDENTIFICADOR:val DECL_ASIG RANGE expresion:e bloque:b
      {: RESULT = new NodoFor(null, null, null, idx, val, b, true, fleft, fright); :}
    ;

sent_for_init ::=
      declaracion_variable:v {: RESULT = v; :}
    | asignacion_variable:a  {: RESULT = a; :}
    ;

sent_for_post ::=
      asignacion_variable:a  {: RESULT = a; :}
    ;

sent_break ::=
      BREAK:b
      {: RESULT = new NodoBreak(bleft, bright); :}
    ;

sent_continue ::=
      CONTINUE:c
      {: RESULT = new NodoContinue(cleft, cright); :}
    ;

sent_return ::=
      RETURN:r expresion:e
      {: RESULT = new NodoReturn(e, rleft, rright); :}
    | RETURN:r
      {: RESULT = new NodoReturn(null, rleft, rright); :}
      %prec NOT
    ;

llamada_funcion ::=
      IDENTIFICADOR:id PAR_IZQ lista_argumentos:args PAR_DER
      {: RESULT = new NodoLlamadaFuncion(id, args, idleft, idright); :}
    | IDENTIFICADOR:paquete PUNTO IDENTIFICADOR:id PAR_IZQ lista_argumentos:args PAR_DER
      {: RESULT = new NodoLlamadaFuncion(paquete + "." + id, args, paqueteleft, paqueteright); :}
    | FMT:f PUNTO PRINTLN PAR_IZQ lista_argumentos:args PAR_DER
      {: RESULT = new NodoPrintln(args, fleft, fright); :}
    ;

lista_argumentos ::=
      lista_argumentos:l COMA expresion:e
      {: l.add(e); RESULT = l; :}
    | expresion:e
      {: List<NodoExpresion> l = new ArrayList<>(); l.add(e); RESULT = l; :}
    |
      {: RESULT = new ArrayList<>(); :}
    ;

expr_atoi ::=
      STRCONV:s PUNTO ATOI PAR_IZQ expresion:e PAR_DER
      {: RESULT = new NodoAtoi(e, sleft, sright); :}
    ;

expr_parsefloat ::=
      STRCONV:s PUNTO PARSEFLOAT PAR_IZQ expresion:e PAR_DER
      {: RESULT = new NodoParsefloat(e, sleft, sright); :}
    ;

expr_typeof ::=
      REFLECT:r PUNTO TYPEOF PAR_IZQ expresion:e PAR_DER
      {: RESULT = new NodoTypeof(e, rleft, rright); :}
    ;

expr_slices_index ::=
      SLICES:s PUNTO INDEX PAR_IZQ expresion:slice COMA expresion:val PAR_DER
      {: RESULT = new NodoSlicesIndex(slice, val, sleft, sright); :}
    ;

expr_strings_join ::=
      STRINGS:s PUNTO JOIN PAR_IZQ expresion:slice COMA expresion:sep PAR_DER
      {: RESULT = new NodoStringsJoin(slice, sep, sleft, sright); :}
    ;

expr_len ::=
      LEN:l PAR_IZQ expresion:e PAR_DER
      {: RESULT = new NodoLen(e, lleft, lright); :}
    ;

expr_append ::=
      APPEND:a PAR_IZQ expresion:slice COMA expresion:val PAR_DER
      {: RESULT = new NodoAppend(slice, val, aleft, aright); :}
    ;

expresion ::=
      expresion:l OR  expresion:r          {: RESULT = new NodoBinaria("||", l, r, lleft, lright); :}
    | expresion:l AND expresion:r          {: RESULT = new NodoBinaria("&&", l, r, lleft, lright); :}
    | expresion:l IGUAL expresion:r        {: RESULT = new NodoBinaria("==", l, r, lleft, lright); :}
    | expresion:l NO_IGUAL expresion:r     {: RESULT = new NodoBinaria("!=", l, r, lleft, lright); :}
    | expresion:l MAYOR expresion:r        {: RESULT = new NodoBinaria(">",  l, r, lleft, lright); :}
    | expresion:l MENOR expresion:r        {: RESULT = new NodoBinaria("<",  l, r, lleft, lright); :}
    | expresion:l MAYOR_IGUAL expresion:r  {: RESULT = new NodoBinaria(">=", l, r, lleft, lright); :}
    | expresion:l MENOR_IGUAL expresion:r  {: RESULT = new NodoBinaria("<=", l, r, lleft, lright); :}
    | expresion:l MAS   expresion:r        {: RESULT = new NodoBinaria("+",  l, r, lleft, lright); :}
    | expresion:l MENOS expresion:r        {: RESULT = new NodoBinaria("-",  l, r, lleft, lright); :}
    | expresion:l MULT  expresion:r        {: RESULT = new NodoBinaria("*",  l, r, lleft, lright); :}
    | expresion:l DIV   expresion:r        {: RESULT = new NodoBinaria("/",  l, r, lleft, lright); :}
    | expresion:l MODULO expresion:r       {: RESULT = new NodoBinaria("%",  l, r, lleft, lright); :}
    | MENOS:m expresion:e                  {: RESULT = new NodoUnaria("-", e, mleft, mright); :} %prec UMENOS
    | NOT:n expresion:e                    {: RESULT = new NodoUnaria("!", e, nleft, nright); :}
    | operando:o                           {: RESULT = o; :}
    | IDENTIFICADOR:paquete PUNTO IDENTIFICADOR:id
      {: RESULT = new NodoAccesoCampo(paquete, id, paqueteleft, paqueteright); :}
    ;

operando ::=
      ENTERO:v       {: RESULT = new NodoLiteral("int",     v, vleft, vright); :}
    | FLOTANTE:v     {: RESULT = new NodoLiteral("float64", v, vleft, vright); :}
    | CADENA:v       {: RESULT = new NodoLiteral("string",  v, vleft, vright); :}
    | RUNE_LIT:v     {: RESULT = new NodoLiteral("rune",    v, vleft, vright); :}
    | TRUE:v         {: RESULT = new NodoLiteral("bool",  true,  vleft, vright); :}
    | FALSE:v        {: RESULT = new NodoLiteral("bool",  false, vleft, vright); :}
    | NIL:v          {: RESULT = new NodoLiteral("nil",   null,  vleft, vright); :}
    | IDENTIFICADOR:id
      {: RESULT = new NodoIdentificador(id, idleft, idright); :}
    | IDENTIFICADOR:id COR_IZQ expresion:idx COR_DER
      {: RESULT = new NodoAccesoSlice(id, idx, null, idleft, idright); :}
    | IDENTIFICADOR:id COR_IZQ expresion:i COR_DER COR_IZQ expresion:j COR_DER
      {: RESULT = new NodoAccesoSlice(id, i, j, idleft, idright); :}
    | PAR_IZQ expresion:e PAR_DER
      {: RESULT = new NodoAgrupacion(e, eleft, eright); :}
    | llamada_funcion:c    {: RESULT = c; :}
    | expr_atoi:e          {: RESULT = e; :}
    | expr_parsefloat:e    {: RESULT = e; :}
    | expr_typeof:e        {: RESULT = e; :}
    | expr_slices_index:e  {: RESULT = e; :}
    | expr_strings_join:e  {: RESULT = e; :}
    | expr_len:e           {: RESULT = e; :}
    | expr_append:e        {: RESULT = e; :}
    | instancia_struct:s   {: RESULT = s; :}
    | literal_slice:s      {: RESULT = s; :}
    ;

literal_slice ::=
      COR_IZQ:c COR_DER tipo:t LLA_IZQ lista_expresiones:es LLA_DER
      {: RESULT = new NodoLiteralSlice(t, null, es, 1, cleft, cright); :}
    | COR_IZQ:c COR_DER tipo:t LLA_IZQ LLA_DER
      {: RESULT = new NodoLiteralSlice(t, null, new ArrayList<>(), 1, cleft, cright); :}
    | COR_IZQ:c COR_DER COR_IZQ COR_DER tipo:t LLA_IZQ lista_filas_slice:fs LLA_DER
      {: RESULT = new NodoLiteralSlice(t, fs, null, 2, cleft, cright); :}
    | COR_IZQ:c COR_DER COR_IZQ COR_DER tipo:t LLA_IZQ LLA_DER
      {: RESULT = new NodoLiteralSlice(t, new ArrayList<>(), null, 2, cleft, cright); :}
    ;

lista_filas_slice ::=
      lista_filas_slice:l COMA fila_slice:f
      {: l.add(f); RESULT = l; :}
    | fila_slice:f
      {: List<NodoLiteralSlice> l = new ArrayList<>(); l.add(f); RESULT = l; :}
    ;

fila_slice ::=
      LLA_IZQ:l lista_expresiones:es LLA_DER
      {: RESULT = new NodoLiteralSlice(null, null, es, 1, lleft, lright); :}
    ;

lista_expresiones ::=
      lista_expresiones:l COMA expresion:e
      {: l.add(e); RESULT = l; :}
    | expresion:e
      {: List<NodoExpresion> l = new ArrayList<>(); l.add(e); RESULT = l; :}
    ;
